{
  "additionalProperties": false,
  "description": "Reference to a stored artifact (log, junit xml, sarif ...).",
  "properties": {
    "id": {
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    }
  },
  "required": [
    "id"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
