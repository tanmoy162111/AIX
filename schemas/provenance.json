{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "description": "Who or what produced an artifact.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "check",
            "control_plane",
            "reviewer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Who, what, from which inputs, under which policy (\u00a721.2).",
  "properties": {
    "aix_version": {
      "title": "Aix Version",
      "type": "string"
    },
    "attempt_id": {
      "anyOf": [
        {
          "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "base_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Commit"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decisions": {
      "items": {
        "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "inputs": {
      "items": {
        "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "policy_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Hash"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "result_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Commit"
    },
    "run_id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "producer",
    "aix_version",
    "created_at"
  ],
  "title": "Provenance",
  "type": "object"
}
