@@ -25,4 +27,15 @@ def handle_request(
     """Route a request. Only ``GET /health`` exists at baseline."""
     if method == "GET" and path == "/health":
         return Response(200, {"status": "ok"})
+    if method == "POST" and path == "/login":
+        creds = body or {}
+        if store is not None and store.verify(creds.get("username", ""), creds.get("password", "")):
+            return Response(200, {"token": create_token(creds["username"], now=time.time())})
+        return Response(401, {"error": "invalid credentials"})
+    if method == "GET" and path == "/me":
+        auth = (headers or {}).get("Authorization", "")
+        user = verify_token(auth.removeprefix("Bearer "), now=time.time()) if auth else None
+        if user is None:
+            return Response(401, {"error": "unauthorized"})
+        return Response(200, {"user": user})
     return Response(404, {"error": "not found"})
diff --git a/tests/test_auth.py b/tests/test_auth.py
new file mode 100644
index 0000000..fb040b6
--- /dev/null
+++ b/tests/test_auth.py
@@ -0,0 +1,44 @@
+import time
+
+from app.auth import create_token, verify_token
+from app.handler import handle_request
+from app.users import UserStore
+
+
+def test_round_trip() -> None:
+    now = time.time()
+    assert verify_token(create_token("ann", now=now), now=now) == "ann"
+
+
+def test_tampered_token_rejected() -> None:
+    now = time.time()
+    token = create_token("ann", now=now)
+    assert verify_token(token[:-2] + "xx", now=now) is None
+
+
+def test_expired_token_rejected() -> None:
+    now = time.time()
+    token = create_token("ann", now=now, ttl=10)
+    assert verify_token(token, now=now + 11) is None
+
+
+def test_login_and_me() -> None:
+    store = UserStore()
+    store.add("ann", "pw")
+    login = handle_request(
+        "POST", "/login", body={"username": "ann", "password": "pw"}, store=store
+    )
+    assert login.status == 200
+    me = handle_request("GET", "/me", headers={"Authorization": "Bearer " + login.body["token"]})
+    assert me.status == 200 and me.body == {"user": "ann"}
+
+
+def test_login_rejects_bad_password() -> None:
+    store = UserStore()
+    store.add("ann", "pw")
+    r = handle_request("POST", "/login", body={"username": "ann", "password": "x"}, store=store)
+    assert r.status == 401
+
+
+def test_me_requires_token() -> None:
+    assert handle_request("GET", "/me").status == 401
