@@ -0,0 +1,42 @@
+"""Minimal HS256 tokens (stdlib only)."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+
+SECRET = b"dev-secret-not-for-production"
+
+
+def _b64(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()
+
+
+def _unb64(text: str) -> bytes:
+    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))
+
+
+def _sign(signing_input: str) -> str:
+    return _b64(hmac.new(SECRET, signing_input.encode(), hashlib.sha256).digest())
+
+
+def create_token(username: str, *, now: float, ttl: int = 3600) -> str:
+    header = _b64(json.dumps({"alg": "HS256", "typ": "JWT"}).encode())
+    payload = _b64(json.dumps({"sub": username, "exp": int(now) + ttl}).encode())
+    return f"{header}.{payload}.{_sign(header + '.' + payload)}"
+
+
+def verify_token(token: str, *, now: float) -> str | None:
+    """Return the username for a valid token, else ``None``."""
+    try:
+        header, payload, signature = token.split(".")
+    except ValueError:
+        return None
+    if not hmac.compare_digest(signature, _sign(header + "." + payload)):
+        return None
+    claims = json.loads(_unb64(payload))
+    if claims["exp"] <= now:
+        return None
+    return str(claims["sub"])
